<Project>
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SourceKit.Analyzers.Collections" PrivateAssets="All" />
        <PackageReference Include="SourceKit.Analyzers.Enumerable" PrivateAssets="All" />
        <PackageReference Include="SourceKit.Analyzers.MustBePartial" PrivateAssets="All" />
        <PackageReference Include="Itmo.Dev.Editorconfig" PrivateAssets="All" />
    </ItemGroup>
</Project>